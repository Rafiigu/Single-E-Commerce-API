meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: http://localhost:5000/api/auth/user/login
  body: json
  auth: none
}

body:json {
  {
    "email": "timothy@gmail.com",
    "password": "timothy123"
  }
}

script:post-response {
  if (res.status === 200) {
    const authToken = res.getBody().data.authToken
    bru.setVar("AUTH_TOKEN", authToken)
  }
}
