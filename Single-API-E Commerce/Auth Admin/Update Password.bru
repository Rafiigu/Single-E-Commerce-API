meta {
  name: Update Password
  type: http
  seq: 3
}

patch {
  url: http://localhost:5000/api/auth/admin/update-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{AUTH_TOKEN}}
}

body:json {
  {
    "currentPassword": "firstadmin@gmail.com",
    "newPassword": "FirstAdmin123$"
  }
}

settings {
  encodeUrl: true
}
