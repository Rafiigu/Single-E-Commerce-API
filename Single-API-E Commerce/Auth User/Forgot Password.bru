meta {
  name: Forgot Password
  type: http
  seq: 5
}

post {
  url: http://localhost:5000/api/auth/user/forgot-password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{AUTH_TOKEN}}
}

body:json {
  {
    "email": "timothyggwp10@gmail.com"
  }
}

script:pre-request {
  if (res.status === 200) {
    const authToken = res.getBody().data.authToken
    bru.setVar("AUTH_TOKEN", authToken)
  }
}
